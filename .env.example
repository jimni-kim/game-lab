# 모델 호출 키: Azure 앞의 LiteLLM 프록시(https://litellm.agenticfw.dev)가 준 키
AGENTIC_OPENAI_KEY=
# 물어볼 모델 이름. 프록시가 내주는 이름은 `python -m gamelab.eval models`로 본다
AGENTIC_OPENAI_MODEL=

# 다른 OpenAI 호환 API를 쓸 때만 (기본: https://litellm.agenticfw.dev/v1)
# AGENTIC_OPENAI_BASE=
# adb 경로를 바꿀 때만 (기본: /opt/homebrew/share/android-commandlinetools/platform-tools/adb)
# GAMELAB_ADB=
