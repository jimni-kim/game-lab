{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "A grid game's fixed properties and its layout relative to the board; where the board is on a screen is measured, never registered",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "revision", "family_id", "fixture_only", "tolerance", "board", "tray", "rules"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$", "maxLength": 64},
    "revision": {"type": "integer", "minimum": 1},
    "family_id": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "description": "a family game.catalog lists"},
    "fixture_only": {"type": "boolean"},
    "offered": {"type": "boolean", "description": "false: not offered to a request in words (a development site kept for regression beside the game's own site); an explicit request may still name it"},
    "controls": {
      "anyOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "keys"],
         "properties": {"kind": {"const": "keys"}, "keys": {
           "type": "object", "additionalProperties": false, "required": ["up", "down", "left", "right"],
           "properties": {"up": {"const": "ArrowUp"}, "down": {"const": "ArrowDown"},
                          "left": {"const": "ArrowLeft"}, "right": {"const": "ArrowRight"}}
         }}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "duration_ms", "pickup"],
         "properties": {"kind": {"const": "drag"}, "duration_ms": {"type": "integer", "minimum": 1, "maximum": 5000},
                        "pickup": {"$ref": "#/$defs/pickup"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind"],
         "description": "taps in place (execution.tap): a family whose moves press a cell or a button",
         "properties": {"kind": {"const": "tap"}}}
      ]
    },
    "settling": {
      "type": "object", "additionalProperties": false, "required": ["timeout_s", "interval_s", "stable_s"],
      "properties": {"timeout_s": {"type": "number", "minimum": 0.1, "maximum": 10},
                     "interval_s": {"type": "number", "minimum": 0.01, "maximum": 1},
                     "stable_s": {"type": "number", "minimum": 0.01, "maximum": 5},
                     "animation_s": {"type": "number", "minimum": 0, "maximum": 2},
                     "still": {"type": "boolean"}}
    },
    "reading": {
      "type": "object", "additionalProperties": false, "required": ["source", "scene", "score"],
      "properties": {
        "source": {"const": "dom"},
        "scene": {"type": "object", "additionalProperties": false, "required": ["selector", "classes"],
                  "properties": {"selector": {"$ref": "#/$defs/selector"},
                                 "classes": {"type": "object", "maxProperties": 4,
                                             "propertyNames": {"$ref": "#/$defs/class_name"},
                                             "additionalProperties": {"enum": ["won", "over"]}}}},
        "score": {"type": "object", "additionalProperties": false, "required": ["selector"],
                  "properties": {"selector": {"$ref": "#/$defs/selector"}}},
        "tiles": {"type": "object", "additionalProperties": false,
                  "required": ["selector", "max", "value", "position", "axes", "origin", "merged"],
                  "properties": {"selector": {"$ref": "#/$defs/selector"},
                                 "max": {"type": "integer", "minimum": 1, "maximum": 128},
                                 "value": {"$ref": "#/$defs/class_pattern"},
                                 "position": {"$ref": "#/$defs/class_pattern"},
                                 "axes": {"enum": [["col", "row"], ["row", "col"]]},
                                 "origin": {"enum": [0, 1]},
                                 "merged": {"$ref": "#/$defs/class_name"}}}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["url"],
      "properties": {"url": {"type": "string", "pattern": "^https://", "maxLength": 512}}
    },
    "tolerance": {"type": "integer", "minimum": 0, "maximum": 12},
    "board": {
      "type": "object", "additionalProperties": false, "required": ["frame", "rows", "cols", "palette"],
      "properties": {
        "frame": {
          "type": "object", "additionalProperties": false, "required": ["rgb", "inset"],
          "description": "how code finds the board: the colour of its frame (border and gutters), and the cell lattice's inset from the frame's edges (left, top, right, bottom) as fractions of the frame's width and height",
          "properties": {"rgb": {"$ref": "#/$defs/rgb"},
                         "opposite": {"$ref": "#/$defs/rgb", "description": "the colour of the frame's right and bottom sides when it is drawn sunk or raised (a bevel lit from one corner), unlike its top and left; the board is found from `rgb`"},
                         "inset": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 0.25}}}
        },
        "rows": {"type": "integer", "minimum": 1, "maximum": 16},
        "cols": {"type": "integer", "minimum": 1, "maximum": 16},
        "palette": {"$ref": "#/$defs/palette"},
        "exact": {"type": "boolean", "description": "a cell shows a value only within tolerance of that value's colour, never as merely the nearest: a palette still being learned (a profile made in a session) lacks values whose colours lie near listed ones"}
      }
    },
    "tray": {"type": "array", "maxItems": 5, "items": {"$ref": "#/$defs/slot"}},
    "tray_band": {"$ref": "#/$defs/place"},
    "rules": {"type": "object", "description": "rule values, each one the family's descriptor lists in rule_parameters, within the values it gives"}
  },
  "$defs": {
    "pickup": {
      "type": "object", "additionalProperties": false, "required": ["anchor", "cell_scale", "offset_cells"],
      "properties": {
        "anchor": {"anyOf": [{"const": "grab"}, {"type": "array", "minItems": 2, "maxItems": 2,
                     "items": {"type": "number", "minimum": 0, "maximum": 1}}]},
        "cell_scale": {"type": "array", "minItems": 2, "maxItems": 2,
                       "items": {"type": "number", "minimum": 0.1, "maximum": 4}},
        "offset_cells": {"type": "array", "minItems": 2, "maxItems": 2,
                         "items": {"type": "number", "minimum": -8, "maximum": 8}}
      }
    },
    "selector": {"type": "string", "minLength": 1, "maxLength": 256},
    "class_name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_-]{0,63}$"},
    "class_pattern": {"type": "string", "minLength": 1, "maxLength": 128},
    "rgb": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "integer", "minimum": 0, "maximum": 255}},
    "place": {
      "type": "array", "minItems": 4, "maxItems": 4,
      "description": "left, top, width, height relative to the board: left and width in board widths, top and height in board heights, from the board's top left corner (a width or height must be positive)",
      "items": {"type": "number", "minimum": -4, "maximum": 4}
    },
    "slot": {
      "type": "object", "additionalProperties": false, "required": ["at", "rows", "cols", "palette"],
      "properties": {
        "at": {"$ref": "#/$defs/place"},
        "rows": {"type": "integer", "minimum": 1, "maximum": 16},
        "cols": {"type": "integer", "minimum": 1, "maximum": 16},
        "piece": {
          "type": "object", "additionalProperties": false, "required": ["cell", "background"],
          "properties": {
            "cell": {"type": "array", "minItems": 2, "maxItems": 2, "description": "a piece cell's width and height as fractions of a board cell's",
                     "items": {"type": "number", "minimum": 0.1, "maximum": 2}},
            "background": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/rgb"}}
          }
        },
        "palette": {"$ref": "#/$defs/palette"}
      }
    },
    "palette": {"type": "array", "minItems": 2, "maxItems": 32, "items": {
      "type": "object", "additionalProperties": false, "required": ["value"],
      "anyOf": [{"required": ["rgb"]}, {"required": ["any"]}],
      "properties": {
        "value": {"type": "integer", "minimum": 0, "maximum": 65536}, "rgb": {"$ref": "#/$defs/rgb"},
        "alternates": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/rgb"}},
        "any": {"const": true, "description": "any colour far from the registered ones (a piece's own colour)"}
      }
    }}
  }
}
